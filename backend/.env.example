# Application
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# Firebase / Firestore
# Point this to your service account JSON file.
# NEVER commit the actual credentials file — it is listed in .gitignore.
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limiting
RATE_LIMIT_ENQUIRIES=5/minute
